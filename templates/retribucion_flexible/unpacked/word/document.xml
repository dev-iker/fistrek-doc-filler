"FFFFFF"/><w:left w:val="none" w:sz="0" w:space="0" w:color="FFFFFF"/><w:bottom w:val="none" w:sz="0" w:space="0" w:color="FFFFFF"/><w:right w:val="none" w:sz="0" w:space="0" w:color="FFFFFF"/></w:tcBorders><w:tcMar><w:top w:w="40" w:type="dxa"/><w:left w:w="240" w:type="dxa"/><w:bottom w:w="40" w:type="dxa"/><w:right w:w="40" w:type="dxa"/></w:tcMar></w:tcPr><w:p w14:paraId="6B5643AC" w14:textId="77777777" w:rsidR="00E31A3E" w:rsidRDefault="00C9538D"><w:pPr><w:spacing w:after="200"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="006BAB"/></w:rPr><w:t>El Trabajador/a</w:t></w:r></w:p><w:p w14:paraId="676F107F" w14:textId="77777777" w:rsidR="00E31A3E" w:rsidRDefault="00C9538D"><w:pPr><w:spacing w:after="100"/></w:pPr><w:r><w:rPr><w:color w:val="1A1A1A"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">D./Dña. </w:t></w:r><w:r><w:rPr><w:color w:val="D0D5DD"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>_______________________</w:t></w:r></w:p><w:p w14:paraId="2AD8D172" w14:textId="77777777" w:rsidR="00E31A3E" w:rsidRDefault="00E31A3E"><w:pPr><w:pBdr><w:bottom w:val="single" w:sz="4" w:space="4" w:color="1A1A1A"/></w:pBdr><w:spacing w:before="700"/></w:pPr></w:p><w:p w14:paraId="5AE7DF2D" w14:textId="77777777" w:rsidR="00E31A3E" w:rsidRDefault="00C9538D"><w:pPr><w:spacing w:before="80"/></w:pPr><w:r><w:rPr><w:i/><w:iCs/><w:color w:val="595959"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>Firma</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p w14:paraId="49B59AA5" w14:textId="77777777" w:rsidR="00C9538D" w:rsidRDefault="00C9538D"/><w:sectPr w:rsidR="00C9538D"><w:headerReference w:type="default" r:id="rId7"/><w:footerReference w:type="default" r:id="rId8"/><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="2000" w:right="1440" w:bottom="1800" w:left="1440" w:header="708" w:footer="708" w:gutter="0"/><w:cols w:space="720"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>